{
  "name": "trb-launcher",
  "version": "1.0.0",
  "description": "TRB Minecraft Launcher",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.trb.launcher",
    "productName": "TRB Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.js",
      "index.html",
      "login.html",
      "package.json",
      "trb-icon.png",
      "node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "trb-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "discord-rpc": "^4.0.1",
    "minecraft-launcher-core": "^3.18.2"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  }
}